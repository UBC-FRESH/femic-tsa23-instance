# data/bc is not ignored: data/bc/siteprod is archived, and a directory-level
# ignore would make a file-level re-include impossible (git will not re-include
# inside an excluded directory).
data/downloads/
# data/shp: the TSA extract is archived.
data/model_input_bundle/
# VRI checkpoints: only the one the analyses consume is archived.
data/*.feather
!data/vri_vclr1p_checkpoint7.feather
data/*.pkl
data/*.parquet
data/03_input-*.csv
data/04_output-*.csv
!data/04_output-tsa23.csv
